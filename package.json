{
  "name": "origin-voxel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3100",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "node scripts/production-smoke.mjs",
    "profile": "node scripts/profile.mjs",
    "deploy": "npm run build && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "three": "0.172.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.13.0",
    "@types/three": "0.172.0",
    "eslint": "9.39.5",
    "gh-pages": "6.3.0",
    "globals": "^15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
